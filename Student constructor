class StudentConstructor {
    String name;
    int age;

    StudentConstructor(String name, int age) {
        this.name = name;
        this.age = age;
    }

    void display() {
        System.out.println("Name: " + name);
        System.out.println("Age: " + age);
    }

    public static void main(String[] args) {
        StudentConstructor s1 = new StudentConstructor("Anna", 19);
        StudentConstructor s2 = new StudentConstructor("Maan", 21);

        s1.display();
        s2.display();
    }
}
