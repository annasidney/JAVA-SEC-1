import java.util.*;

class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter size of array: ");
        int n = sc.nextInt();

        int a[] = new int[n];

        System.out.println("Enter array elements:");

        for(int i = 0; i < n; i++) {
            a[i] = sc.nextInt();
        }

        System.out.println("Array in reverse:");

        for(int i = n - 1; i >= 0; i--) {
            System.out.print(a[i] + " ");
        }
    }
}
